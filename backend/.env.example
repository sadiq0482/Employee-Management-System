# --------------------------------------------------------------------------
# Copy this file to ".env" in the same folder (backend/.env) and fill in
# real values. NEVER commit the real ".env" file to Git.
# --------------------------------------------------------------------------

# Django secret key. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production. Only True for local development.
DEBUG=True

# MySQL database connection
DB_NAME=employee_management_db
DB_USER=emsuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Comma separated list, no spaces, e.g: localhost,127.0.0.1,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated list of frontend origins allowed to call this API
# e.g: http://localhost:3000,https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional
TIME_ZONE=UTC
SECURE_SSL_REDIRECT=True
